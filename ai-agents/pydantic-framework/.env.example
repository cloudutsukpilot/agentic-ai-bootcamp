# Copy to ai-agents/pydantic-framework/.env and replace the placeholders.
# Every numbered stage reads this one shared file; a nonempty process
# environment variable with the same name wins over the file value.

# Stage 01 only: Azure OpenAI resource endpoint, API key, and deployment name.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_MODEL=<your-deployment-name>

# Stages 02-10: Foundry project endpoint and model deployment name.
# The FOUNDARY_* spelling intentionally matches the Microsoft Agent Framework stages.
FOUNDARY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDARY_MODEL=<your-deployment-name>
